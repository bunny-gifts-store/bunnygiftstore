RewriteEngine On

# Force HTTPS on Apache/GoDaddy hosting.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# SPA fallback: serve index.html for any path that is not a real file/dir so
# React Router deep links (e.g. /admin, /policy) load instead of 404-ing.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Basic hardening headers.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# ===== Progressive Web App =====
# Correct MIME types so the manifest and worker are accepted by the browser.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType text/javascript .js
</IfModule>

# Only /assets/* is content-hashed by Vite, so only that is safe to freeze.
# Everything else keeps a short, revalidating cache so a redeploy is picked up.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/" PWA_IMMUTABLE=1
    SetEnvIf Request_URI "^/(images|css)/" PWA_SHORT_CACHE=1
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=PWA_IMMUTABLE
    Header set Cache-Control "public, max-age=604800" env=PWA_SHORT_CACHE

    # These must always be revalidated, otherwise a deployment can stay
    # invisible behind the HTTP cache for as long as its max-age.
    <FilesMatch "^(sw\.js|index\.html|offline\.html|404\.html|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # Allow the worker to control the whole origin.
    <FilesMatch "^sw\.js$">
        Header set Service-Worker-Allowed "/"
    </FilesMatch>
</IfModule>

# Serve pre-compressed responses where the server supports it.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
