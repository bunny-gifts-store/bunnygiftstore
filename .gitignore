# Secrets / env
.env
.env.*
*.key
*.pem
*.pfx
secrets.json
credentials.json

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node (if added later)
node_modules/
npm-debug.log*
yarn-debug.log*

# Build output
dist/
build/

# Server database (contains customer order data — never publish)
*.db
*.db-shm
*.db-wal
server/*.db

# Database snapshots from `npm run db:pull` (real customers, orders and
# password hashes — never publish)
live-snapshot.json
server/live-snapshot.json
server/*-snapshot.json

# Uploaded item images (runtime data — keep the folder, ignore contents)
server/uploads/*
!server/uploads/.gitkeep

# Logs
*.log

# Python (for the asset generator script)
__pycache__/
*.pyc
.venv/
venv/

# Runtime catalogue snapshot (served when the database is unreachable)
server/cache/
